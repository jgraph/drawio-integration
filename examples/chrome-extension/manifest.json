{
  "name": "draw.io for Your App",
  "version": "1.0.0",
  "description": "Insert and edit draw.io diagrams in your web application",
  "host_permissions": [
  	"https://*.your-app.example.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.your-app.example.com/*"
      ],
      "all_frames": true,
      "run_at": "document_end",
      "js": ["contentScript.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "images/logo16.png",
    "32": "images/logo32.png",
    "48": "images/logo48.png",
    "128": "images/logo128.png"
  },
  "manifest_version": 3
}
